---
import { LOCALES, ui, type Locale } from '../lib/i18n';

interface Props {
  lang: Locale;
  hrefs: Record<Locale, string>;
  statusText: string;
  statusId?: string;
}
const { lang, hrefs, statusText, statusId } = Astro.props;
const t = ui(lang);
---
<header class="topbar">
  <div class="identity">
    <span class="identity__name">UNAX <span class="identity__accent">ZULA</span>IKA FUENTE</span>
    <span class="identity__role">{t.site.identityRole}</span>
  </div>
  <div class="topbar-controls">
    <!-- Selector de idioma (.sys-btn): en reposo, globo + idioma actual; al pasar el ratón
         o con el foco se abre y muestra «EN / ES». En pantallas táctiles va siempre abierto. -->
    <nav class="sys-btn lang-switch" aria-label={t.site.language}>
      <svg class="sys-btn__icon lang-switch__globe" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="8.5" opacity="0.45" />
        <path d="M3.5 12h17M12 3.5c2.6 2.4 3.6 5.3 3.6 8.5s-1 6.1-3.6 8.5c-2.6-2.4-3.6-5.3-3.6-8.5s1-6.1 3.6-8.5z" />
      </svg>
      {LOCALES.map((l, i) => (
        <>
          {i > 0 && <span class="lang-switch__sep" aria-hidden="true">/</span>}
          <a
            class:list={['lang-switch__btn', { 'is-active': l === lang }]}
            href={hrefs[l]}
            hreflang={l}
            lang={l}
            data-lang-switch={l}
            aria-current={l === lang ? 'true' : undefined}
          >{l.toUpperCase()}</a>
        </>
      ))}
    </nav>
    <div class="status-chip">
      <span class="status-dot" aria-hidden="true"></span>
      <span class="status-text" id={statusId ?? 'core-status-text'}>{statusText}</span>
    </div>
  </div>
</header>
