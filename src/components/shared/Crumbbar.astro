---
/**
 * Back button + breadcrumb trail. One component instead of the
 * about-crumbbar/capabilities-crumbbar/contact-crumbbar/keyping-crumbbar…
 * markup duplicated per legacy page (same structure, only the class prefix
 * differed).
 *
 * The round back button is a smart back, like Windows Explorer's: it
 * returns to wherever this tab actually came from within the site, and
 * only falls back to the Core — its `href`, used as-is with no JS — when
 * there's nowhere in-site to go back to (a fresh tab, a deep link, or
 * having already walked back to the site's own entry point). See the
 * script below for how that's tracked.
 */
interface Crumb {
  label: string;
  href?: string; // omitted on the last (current) crumb
}

interface Props {
  crumbs: Crumb[];
  backHref: string;
  backLabel: string;
}

const { crumbs, backHref, backLabel } = Astro.props;
---

<nav class="crumbbar" aria-label="Screen path">
  <a href={backHref} class="crumbbar__back" aria-label={backLabel}>
    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
      <path d="M15 5L8 12L15 19" />
    </svg>
  </a>
  <p class="crumbbar__trail">
    {crumbs.map((crumb, index) => (
      <>
        <span class="crumbbar__sep" aria-hidden="true">/</span>
        {crumb.href ? (
          <a href={crumb.href}>{crumb.label}</a>
        ) : (
          <span class="crumbbar__current" aria-current="page">{crumb.label}</span>
        )}
      </>
    ))}
  </p>
</nav>

<script>
  // Smart back, à la Windows Explorer: go to whichever page this tab
  // actually navigated here from within the site, not always the Core.
  //
  // document.referrer can't drive this — it's frozen at the tab's very
  // first hard load and Astro's view-transition navigations (a plain
  // pushState swap, no reload) never update it. Raw history.length can't
  // either: it never shrinks when navigating backward, so it can't tell
  // "several pages deep" apart from "back at the site's entry point".
  //
  // Instead we keep our own stack of visited pathnames in sessionStorage,
  // one entry per in-site page (deduped against reloads of the same
  // page), and truncated back down to size on a real back/forward so it
  // stays in sync with the browser's own history rather than only ever
  // growing. The back button then just checks whether that stack is more
  // than one page deep before hijacking the click into a real
  // history.back() — otherwise its plain href (the Core) applies as-is.
  function currentPath() {
    return location.pathname + location.search;
  }

  function readStack(): string[] {
    try {
      const raw = sessionStorage.getItem("crumbbar-nav-stack");
      const parsed = raw ? JSON.parse(raw) : [];
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  }

  function writeStack(stack: string[]) {
    sessionStorage.setItem("crumbbar-nav-stack", JSON.stringify(stack));
  }

  function onPageLoad() {
    const path = currentPath();
    const stack = readStack();
    const isBackNav = sessionStorage.getItem("crumbbar-popstate-pending") === "1";
    sessionStorage.removeItem("crumbbar-popstate-pending");

    if (isBackNav) {
      // Landed here via a real back/forward: the stack already reached
      // this page on the way forward, so trim anything recorded after it
      // instead of pushing a duplicate.
      const index = stack.lastIndexOf(path);
      if (index !== -1) writeStack(stack.slice(0, index + 1));
      return;
    }

    if (stack[stack.length - 1] !== path) {
      stack.push(path);
      writeStack(stack);
    }
  }

  function onBackClick(event: MouseEvent) {
    const back = (event.target as HTMLElement)?.closest<HTMLAnchorElement>(".crumbbar__back");
    if (!back) return;

    const stack = readStack();
    if (stack.length > 1) {
      event.preventDefault();
      history.back();
    }
    // Otherwise: nothing in-site to go back to — fall through to the
    // anchor's own href, which targets the Core.
  }

  // Bound once, ever, via the window flag: this script's top-level code
  // re-runs on every visit to a module page (each one a distinct
  // closure), so without the flag every revisit would register another
  // set of listeners that never gets cleaned up. Both listeners live on
  // window/document, which persist across Astro's view transitions, so
  // binding them once here keeps tracking navigation for the rest of the
  // tab's life — including visits to pages (like the Core) that don't
  // render this component at all.
  const w = window as typeof window & { __crumbbarNavBound?: boolean };
  if (!w.__crumbbarNavBound) {
    window.addEventListener("popstate", () => {
      sessionStorage.setItem("crumbbar-popstate-pending", "1");
    });
    document.addEventListener("astro:page-load", onPageLoad);
    document.addEventListener("click", onBackClick);
    w.__crumbbarNavBound = true;
  }
  onPageLoad();
</script>

<style>
  .crumbbar {
    /* A normal flex child of .module-stage, not an overlay: it used to be
     * position: absolute, floating over .module-scroll so its own top
     * padding could "clear" it visually — but that also meant
     * module-scroll's box (and therefore its native scrollbar) started at
     * y:0, underneath the bar, instead of at its actual bottom edge. As a
     * regular flex item, module-scroll now simply starts right after this
     * ends, so the scrollbar starts there too. */
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    margin: 0;
    padding: 7px 24px;
    border-bottom: 1px solid rgba(124, 168, 194, 0.18);
    background: linear-gradient(180deg, rgba(8, 19, 30, 0.94), rgba(8, 19, 30, 0.42));
  }

  .crumbbar__back {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    border: 1px solid rgba(143, 186, 214, 0.36);
    border-radius: 999px;
    color: #e4f3ff;
    background: linear-gradient(145deg, rgba(14, 30, 43, 0.9), rgba(9, 20, 31, 0.85));
    text-decoration: none;
  }

  .crumbbar__back svg {
    width: 13px;
    height: 13px;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
  }

  .crumbbar__trail {
    margin: 0;
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #bfd9eb;
  }

  .crumbbar__sep {
    color: #79a9c6;
  }

  .crumbbar__trail a {
    color: inherit;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .crumbbar__trail a:hover,
  .crumbbar__trail a:focus-visible {
    color: #e7f6ff;
  }

  .crumbbar__current {
    color: var(--accent-strong);
  }

  @media (max-width: 860px) {
    .crumbbar {
      min-height: 36px;
      padding: 6px 14px;
    }
    .crumbbar__trail {
      font-size: 0.64rem;
      gap: 6px;
    }
    .crumbbar__back {
      width: 26px;
      height: 26px;
    }
  }
</style>
