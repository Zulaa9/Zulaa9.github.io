---
/** System Core: escena 3D + nodos generados a partir de los módulos visibles. */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getVisibleModules, layoutNodes, moduleHref } from '../lib/modules';
import { tr, ui, type Locale } from '../lib/i18n';
import coreCss from '../styles/core.css?url';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = ui(lang);
const modules = await getVisibleModules();
const positions = layoutNodes(modules.map((m) => ({ id: m.id, position: m.data.node.position, parent: m.data.parent })));
const featured = modules.find((m) => m.data.node.featured) ?? modules[0];
const nodes = modules.map((m, i) => ({
  id: m.id,
  href: moduleHref(m, lang),
  title: tr(m.data.node.title, lang),
  meta: tr(m.data.node.meta, lang),
  mobile: tr(m.data.node.mobileLabel, lang) || tr(m.data.node.title, lang),
  dock: { title: tr(m.data.node.dock.title, lang), copy: tr(m.data.node.dock.copy, lang) },
  featured: !!m.data.node.featured,
  parent: m.data.parent && modules.some((x) => x.id === m.data.parent) ? m.data.parent : undefined,
  position: positions.get(m.id)!,
  delay: 20 + i * 60,
}));
const coreData = {
  nodes: nodes.map(({ id, href, dock, parent, position, featured: f }) => ({ id, href, dock, parent, position, featured: f })),
  defaultActive: featured?.id ?? '',
  status: t.core.status,
  bootLines: t.core.boot.lines,
  threeError: t.core.threeError,
};
// Datos estructurados de la persona (nombre, rol y perfiles públicos enlazados en los módulos).
const sameAs = [...new Set(modules.flatMap((m) => (m.data.template === 'section' ? m.data.section.blocks : []).flatMap((b) => (b.type === 'links' ? b.links.map((l) => l.url) : [])).filter((u) => /^https:/.test(u))))];
const person = { '@context': 'https://schema.org', '@type': 'Person', name: 'Unax Zulaika Fuente', url: Astro.site!.href, jobTitle: t.site.identityRole, sameAs };
const featuredDock = nodes.find((n) => n.id === featured?.id)?.dock;
---
<BaseLayout
  lang={lang}
  title={t.core.page.title}
  description={t.core.page.description}
  path=""
  shellLabel="System Core"
  statusText={t.core.status.offline}
>
  <Fragment slot="head">
    <link rel="stylesheet" href={coreCss} />
    <script is:inline>
      // Si se llega desde una página con la ventana ampliada, el Core empieza ampliado
      // y se restaura con animación (el Core no tiene botón de ampliar).
      try {
        if (sessionStorage.getItem('zula:screen-expanded') === '1') {
          sessionStorage.removeItem('zula:screen-expanded');
          if (window.matchMedia('(min-width: 861px)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            const h = sessionStorage.getItem('zula:topbar-h');
            if (h) document.documentElement.style.setProperty('--topbar-h', h);
            document.documentElement.classList.add('core-restoring');
          }
        }
      } catch {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script type="application/json" id="core-data" set:html={JSON.stringify(coreData)} />
  </Fragment>

  <div class="core-stage" id="core-stage">
    <script is:inline>
      // Al volver de una página, el Core pinta la barra de ruta de esa página y la sube.
      (function () {
        try {
          var html = sessionStorage.getItem('zula:crumbbar');
          sessionStorage.removeItem('zula:crumbbar');
          var ref = document.referrer ? new URL(document.referrer) : null;
          if (!html || !ref || ref.origin !== location.origin || /^\/(es\/?)?$/.test(ref.pathname)) return;
          var stage = document.currentScript.parentElement;
          var tpl = document.createElement('template');
          tpl.innerHTML = html;
          var bar = tpl.content.firstElementChild;
          if (!bar || !bar.classList.contains('crumbbar')) return;
          bar.classList.add('crumbbar--ghost');
          bar.removeAttribute('style');
          stage.prepend(bar);
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              bar.classList.add('is-leaving');
              setTimeout(function () { bar.remove(); }, 700);
            });
          });
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      // Restaurar tras el primer pintado; la escena 3D se reajusta mientras dura la animación.
      (function () {
        var root = document.documentElement;
        if (!root.classList.contains('core-restoring')) return;
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            root.classList.add('core-restore-anim');
            root.classList.remove('core-restoring');
            var start = performance.now();
            (function step(now) {
              window.dispatchEvent(new Event('resize'));
              if (now - start < 520) requestAnimationFrame(step);
              else root.classList.remove('core-restore-anim');
            })(start);
          });
        });
      })();
    </script>
    <section class="startup-gate" id="startup-gate" aria-label={t.core.startup.title}>
      <div class="startup-gate__panel">
        <p class="eyebrow">{t.core.startup.eyebrow}</p>
        <h2>{t.core.startup.title}</h2>
        <p>{t.core.startup.copy}</p>
        <button class="startup-gate__button" id="start-core-button" type="button">{t.core.startup.cta}</button>
      </div>
    </section>

    <section class="boot-sequence" id="boot-sequence" aria-label={t.core.boot.eyebrow}>
      <div class="boot-door boot-door--top" aria-hidden="true"></div>
      <div class="boot-door boot-door--bottom" aria-hidden="true"></div>
      <div class="boot-terminal">
        <p class="boot-terminal__eyebrow">{t.core.boot.eyebrow}</p>
        <div class="boot-terminal__screen">
          <ul class="boot-log" id="boot-log" aria-live="polite"></ul>
          <div class="boot-progress">
            <div class="boot-progress__bar"><span id="boot-progress-fill"></span></div>
            <span class="boot-progress__text" id="boot-progress-text">0%</span>
          </div>
        </div>
      </div>
    </section>

    <canvas id="core-canvas" aria-hidden="true"></canvas>
    <svg id="node-links" class="node-links" aria-hidden="true"></svg>
    <div class="core-center" id="core-center" aria-hidden="true"></div>

    <div class="node-layer" id="node-layer" role="navigation" aria-label={t.site.modulesLabel}>
      {nodes.map((n) => (
        <a
          class:list={['module-node', 'module-trigger', { 'module-node--featured': n.featured, 'module-node--west': n.position.x < 0.5 }]}
          href={`${n.href}?from=core`}
          data-target={n.id}
          style={`--reveal-delay: ${n.delay}ms`}
        >
          <span class="node-anchor" aria-hidden="true"></span>
          <span class="node-text">
            <span class="node-title">{n.title}</span>
            <span class="node-meta">{n.meta}</span>
          </span>
        </a>
      ))}
    </div>

    <article class="core-copy" id="main-content" tabindex="-1">
      <p class="eyebrow">{t.core.copy.eyebrow}</p>
      <h1>{t.core.copy.title}</h1>
      <p set:html={t.core.copy.body} />
    </article>

    <div class="info-dock" id="info-dock" aria-live="polite">
      <p class="info-dock__label">{t.core.dock.label}</p>
      <h2 id="dock-title">{featuredDock?.title ?? t.core.dock.defaultTitle}</h2>
      <p id="dock-copy">{featuredDock?.copy ?? t.core.dock.defaultCopy}</p>
    </div>
  </div>

  <nav class="mobile-modules" aria-label={t.site.modulesLabel}>
    {nodes.map((n) => (
      <a class:list={['mobile-modules__item', 'module-trigger', { 'mobile-modules__item--featured': n.featured }]} href={`${n.href}?from=core`} data-target={n.id}>
        <span>{n.mobile}</span>
        <span class="mobile-modules__meta">{n.meta}</span>
      </a>
    ))}
  </nav>
</BaseLayout>

<script>
  import { initSystemCore } from '../scripts/core/system-core';
  initSystemCore();
</script>
