---
import { ui, type Locale } from '../lib/i18n';
interface Props { lang: Locale }
const t = ui(Astro.props.lang);
---
<aside class="lightbox" id="keyping-lightbox" aria-hidden="true">
  <div class="lightbox__backdrop" data-lightbox-close></div>
  <div class="lightbox__dialog" role="dialog" aria-modal="true" aria-label={t.lightbox.viewer}>
    <button type="button" class="sys-btn lightbox__close" id="keyping-lightbox-close" data-lightbox-close aria-label={t.lightbox.close}>
      <svg class="sys-btn__icon lightbox__x" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6L18 18M18 6L6 18" /></svg>
    </button>
    <button type="button" class="sys-btn lightbox__nav lightbox__nav--prev" id="keyping-lightbox-prev" aria-label={t.lightbox.prev}>
      <svg class="sys-btn__icon sys-btn__icon--buzz-left" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5L8 12L15 19" /></svg>
    </button>
    <figure class="lightbox__figure">
      <img id="keyping-lightbox-image" alt="" />
      <img id="keyping-lightbox-image-secondary" alt="" />
      <video id="keyping-lightbox-video" controls preload="metadata" playsinline></video>
      <figcaption id="keyping-lightbox-caption"></figcaption>
    </figure>
    <button type="button" class="sys-btn lightbox__nav lightbox__nav--next" id="keyping-lightbox-next" aria-label={t.lightbox.next}>
      <svg class="sys-btn__icon sys-btn__icon--buzz-right" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5L16 12L9 19" /></svg>
    </button>
  </div>
</aside>
