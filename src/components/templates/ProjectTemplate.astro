---
/** Plantilla "Proyecto" (layout standard). Los proyectos "flagship" usan FlagshipProject. */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { tr, ui, type Locale } from '../../lib/i18n';
import type { ModuleEntry } from '../../lib/modules';
import { localizeMedia } from '../../lib/media';
import PageHeader from '../ui/PageHeader.astro';
import Sec from '../ui/Sec.astro';
import StatusTag from '../ui/StatusTag.astro';

interface Props { module: ModuleEntry; lang: Locale }
const { module, lang } = Astro.props;
if (module.data.template !== 'project') throw new Error('ProjectTemplate necesita un módulo "project"');
const p = module.data.project;
const t = ui(lang);
// Las imágenes de la galería se abren en el visor a tamaño completo.
const full = async (src: ImageMetadata) => (await getImage({ src, width: Math.min(1920, src.width), format: 'webp', quality: 85 })).src;
const media = await Promise.all(
  localizeMedia(p.media, lang).map(async (item) => ({
    item,
    full: item.type === 'image' ? [await full(item.src)] : item.type === 'composite' ? await Promise.all(item.parts.map((x) => full(x.src))) : [],
  })),
);
let n = 0;
---
<article class="page-body">
  <PageHeader eyebrow={tr(p.header.eyebrow, lang)} title={tr(p.header.title, lang)} lead={tr(p.header.lead, lang)}>
    {p.links.length > 0 && (
      <div class="actions">
        {p.links.map((l, i) => (
          <a class:list={[i === 0 || l.kind === 'download' ? 'btn btn--primary' : 'link-arrow']} href={lang === 'es' && l.urlEs ? l.urlEs : l.url} target="_blank" rel="noopener noreferrer">{tr(l.label, lang)} <span aria-hidden="true">↗</span></a>
        ))}
      </div>
    )}
    {p.status && p.status.tone !== 'neutral' && (
      <StatusTag label={tr(p.status.label, lang)} value={tr(p.status.value, lang)} tone={p.status.tone} />
    )}
    {p.status && p.status.tone === 'neutral' && (
      <dl class="spec spec--compact" slot="aside">
        <div><dt>{tr(p.status.label, lang)}</dt><dd>{tr(p.status.value, lang)}</dd></div>
      </dl>
    )}
  </PageHeader>

  <figure class:list={['figure', 'figure--cover', { 'figure--logo': p.cover.fit === 'logo' }]}>
    <Image src={p.cover.src} alt={tr(p.cover.alt, lang)} widths={[640, 1280, 1920]} sizes="(max-width: 1180px) 92vw, 1100px" loading="eager" decoding="async" />
  </figure>

  <Sec index={++n} title={tr(p.description.title, lang)}>
    <div class="prose">{p.description.paragraphs.map((para) => <p>{tr(para, lang)}</p>)}</div>
  </Sec>

  {p.stack.length > 0 && (
    <Sec index={++n} title={tr(p.stackTitle, lang) || 'Stack'}>
      <ul class="tech tech--primary">{p.stack.map((s) => <li>{tr(s, lang)}</li>)}</ul>
    </Sec>
  )}

  {p.sections.map((s) => (
    <Sec index={++n} title={tr(s.title, lang)}>
      <ul class="ruled">{s.items.map((i) => <li>{tr(i, lang)}</li>)}</ul>
    </Sec>
  ))}

  {media.length > 0 && (
    <div class="gallery-grid">
      {media.map(({ item, full }) => item.type === 'video' ? (
        <figure class="shot">
          <video controls muted playsinline preload="metadata" aria-label={tr(item.alt, lang)}>
            <source src={item.src} type={item.src.endsWith('.webm') ? 'video/webm' : 'video/mp4'} />
          </video>
          <figcaption>{tr(item.caption, lang)}</figcaption>
        </figure>
      ) : (
        <figure class="shot gallery__item" tabindex="0" role="button" aria-label={`${t.lightbox.openMedia}: ${tr(item.type === 'image' ? item.alt : item.caption, lang)}`}>
          {item.type === 'image' && (
            <Image src={item.src} alt={tr(item.alt, lang)} widths={[480, 960]} sizes="(max-width: 860px) 92vw, 480px" loading="lazy" decoding="async" data-full={full[0]} />
          )}
          {item.type === 'composite' && (
            <div class="shot__pair gallery__composite">
              {item.parts.map((part, j) => (
                <Image src={part.src} alt={tr(part.alt, lang)} widths={[480, 960]} sizes="(max-width: 860px) 92vw, 480px" loading="lazy" decoding="async" data-full={full[j]} />
              ))}
            </div>
          )}
          <figcaption>{tr(item.caption, lang)}</figcaption>
        </figure>
      ))}
    </div>
  )}
</article>
