---
/** Índice de proyectos: cabecera + los módulos "project" hijos de este módulo. */
import { Image } from 'astro:assets';
import { tr, localePath, ui, type Locale } from '../../lib/i18n';
import type { ModuleEntry } from '../../lib/modules';
import PageHeader from '../ui/PageHeader.astro';
import StatusTag from '../ui/StatusTag.astro';

interface Props { module: ModuleEntry; all: ModuleEntry[]; lang: Locale }
const { module, all, lang } = Astro.props;
if (module.data.template !== 'projects') throw new Error('ProjectsTemplate necesita un módulo "projects"');
const d = module.data.projects;
const t = ui(lang);
const projects = all.filter((m) => m.data.visible && m.data.template === 'project' && m.data.parent === module.id);
---
<article class="page-body">
  <PageHeader eyebrow={tr(d.header.eyebrow, lang)} title={tr(d.header.title, lang)} lead={tr(d.header.lead, lang)} />

  <ol class="projects">
    {projects.map((m, i) => {
      if (m.data.template !== 'project') return null;
      const p = m.data.project;
      const href = `${localePath(lang, m.data.path)}?from=${module.id}`;
      const gh = p.links.find((l) => l.kind === 'github');
      return (
        <li class:list={['proj', { 'proj--featured': p.featured }]}>
          <a class:list={['proj__media', { 'proj__media--logo': p.cover.fit === 'logo' }]} href={href} tabindex="-1" aria-hidden="true">
            <Image src={p.cover.src} alt="" widths={p.cover.fit === 'logo' ? [160, 320] : [480, 960]} sizes={p.cover.fit === 'logo' ? '160px' : '(max-width: 860px) 92vw, 520px'} loading="lazy" decoding="async" />
          </a>
          <div class="proj__body">
            <p class="kicker"><span class="kicker__index">{String(i + 1).padStart(2, '0')}</span> {tr(p.cardEyebrow, lang)}</p>
            <h2 class="proj__title"><a href={href}>{tr(p.name, lang)}</a></h2>
            <p class="proj__summary">{tr(p.summary, lang)}</p>
            {p.status?.onCard && <StatusTag label={tr(p.status.label, lang)} value={tr(p.status.value, lang)} tone={p.status.tone} />}
            <ul class="tech tech--small">{p.stack.map((s) => <li>{tr(s, lang)}</li>)}</ul>
            <div class="actions">
              <a class:list={['btn', { 'btn--primary': p.featured }]} href={href}>{tr(p.enterLabel, lang)} <span aria-hidden="true">→</span></a>
              {gh && <a class="link-arrow" href={lang === 'es' && gh.urlEs ? gh.urlEs : gh.url} target="_blank" rel="noopener noreferrer">{tr(gh.label, lang) || t.projects.github} <span aria-hidden="true">↗</span></a>}
            </div>
          </div>
        </li>
      );
    })}
  </ol>
</article>
