---
/**
 * Vista de producto estrella (layout "flagship" de la plantilla Proyecto).
 * Es un componente específico porque su maquetación (salud del módulo, pills,
 * galería con visor, tarjetas de arquitectura…) no se puede expresar sin pérdida
 * con la plantilla estándar. Todo su contenido sigue en el archivo del módulo.
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { tr, ui, type Locale } from '../../lib/i18n';
import type { ModuleEntry } from '../../lib/modules';

interface Props { module: ModuleEntry; lang: Locale }
const { module, lang } = Astro.props;
if (module.data.template !== 'project' || !module.data.project.flagship) throw new Error('FlagshipProject necesita un proyecto flagship');
const p = module.data.project;
const f = p.flagship!;
const t = ui(lang);
const full = async (src: ImageMetadata) => (await getImage({ src, width: Math.min(1920, src.width), format: 'webp', quality: 85 })).src;

type Item = (typeof f.gallery.items)[number];
const withFull = await Promise.all(
  f.gallery.items.map(async (item: Item) => ({
    item,
    full: item.type === 'image' ? [await full(item.src)] : item.type === 'composite' ? await Promise.all(item.parts.map((x) => full(x.src))) : [],
  })),
);
const hero = withFull.filter((x) => x.item.placement === 'hero');
const rail = withFull.filter((x) => x.item.placement === 'rail');
const extra = withFull.filter((x) => x.item.placement === 'extra');
const thumbSizes = '(max-width: 860px) 92vw, 420px';
---
<section class="keyping-module-shell" aria-label={tr(p.name, lang)}>
  <div class="keyping-header">
    <div class="keyping-mark" aria-hidden="true">
      <Image src={f.logo} alt="" width={112} loading="eager" />
    </div>
    <div class="keyping-title">
      <p class="eyebrow">{tr(p.header.eyebrow, lang)}</p>
      <h1>{tr(p.header.title, lang)}</h1>
      <p class="keyping-tagline">{tr(p.header.lead, lang)}</p>
      <p class="keyping-punchline">{tr(f.punchline, lang)}</p>
    </div>
    {p.status && (
      <div class="keyping-health">
        <p class="keyping-health__label">{tr(p.status.label, lang)}</p>
        <p class="keyping-health__state">{tr(p.status.value, lang)}</p>
      </div>
    )}
  </div>

  <div class="keyping-pills">
    {f.pills.map((pill) => <span class="keyping-pill">{tr(pill, lang)}</span>)}
  </div>

  <section class="keyping-section">
    <h2 class="keyping-h3">{tr(p.description.title, lang)}</h2>
    {p.description.paragraphs.map((para) => <p>{tr(para, lang)}</p>)}
    {f.actions.length > 0 && (
      <div class="keyping-actions">
        {f.actions.map((a) => (
          <a class={`keyping-action keyping-action--${a.variant}`} href={a.url} target="_blank" rel="noopener noreferrer">
            <span class="keyping-action__eyebrow">{tr(a.eyebrow, lang)}</span>
            <span class="keyping-action__title">{tr(a.label, lang)}</span>
          </a>
        ))}
      </div>
    )}
  </section>

  <section class="keyping-section keyping-why">
    <h2 class="keyping-h3">{tr(f.why.title, lang)}</h2>
    <p class="keyping-why__subtitle">{tr(f.why.subtitle, lang)}</p>
    <p>{tr(f.why.lead, lang)}</p>
    <div class="keyping-why-grid">
      {f.why.cards.map((c) => (
        <article class="keyping-why-card">
          <h3 class="keyping-h4">{tr(c.title, lang)}</h3>
          <p>{tr(c.copy, lang)}</p>
        </article>
      ))}
    </div>
    {f.why.focus && (
      <div class="keyping-why-focus">
        <h3 class="keyping-h4">{tr(f.why.focus.title, lang)}</h3>
        <p>{tr(f.why.focus.copy, lang)}</p>
      </div>
    )}
  </section>

  <section class="keyping-section keyping-metrics">
    <h2 class="keyping-h3">{tr(f.metrics.title, lang)}</h2>
    <p class="keyping-metrics__subtitle">{tr(f.metrics.subtitle, lang)}</p>
    <ul class="keyping-metrics-grid">{f.metrics.items.map((i) => <li>{tr(i, lang)}</li>)}</ul>
    <p class="keyping-metrics__statement">{tr(f.metrics.statement, lang)}</p>
  </section>

  <section class="keyping-section keyping-visuals">
    <h2 class="keyping-h3">{tr(f.gallery.title, lang)}</h2>
    <p>{tr(f.gallery.lead, lang)}</p>
    <div class="keyping-media-grid">
      {hero.map(({ item }) => item.type === 'video' && (
        <figure class="keyping-media keyping-media--hero" tabindex="0" role="button" aria-label={`${t.lightbox.openMedia}: ${tr(item.alt, lang)}`}>
          <video autoplay muted loop playsinline preload="metadata" aria-label={tr(item.alt, lang)}>
            <source src={item.src} type={item.src.endsWith('.webm') ? 'video/webm' : 'video/mp4'} />
          </video>
          <figcaption>{tr(item.caption, lang)}</figcaption>
        </figure>
      ))}
      <div class="keyping-media-rail">
        {rail.map(({ item, full }, i) => {
          const more = extra.length > 0 && i === rail.length - 1;
          if (item.type === 'composite') {
            return (
              <figure class:list={['keyping-media keyping-media--composite', { 'keyping-media--more': more }]} tabindex="0" role="button" aria-label={`${t.lightbox.openMedia}: ${tr(item.caption, lang)}`}>
                <div class="keyping-media-composite">
                  {item.parts.map((part, j) => (
                    <Image src={part.src} alt={tr(part.alt, lang)} widths={[420, 840]} sizes={thumbSizes} loading="lazy" decoding="async" data-full={full[j]} />
                  ))}
                </div>
                {more && <span class="keyping-media-more-badge">{tr(f.gallery.moreBadge, lang)}</span>}
                <figcaption>{tr(item.caption, lang)}</figcaption>
              </figure>
            );
          }
          if (item.type === 'image') {
            return (
              <figure class:list={['keyping-media', { 'keyping-media--more': more, 'keyping-media--compact': item.compact }]} tabindex="0" role="button" aria-label={`${t.lightbox.openMedia}: ${tr(item.alt, lang)}`}>
                <Image src={item.src} alt={tr(item.alt, lang)} widths={[420, 840]} sizes={thumbSizes} loading="lazy" decoding="async" data-full={full[0]} />
                {more && <span class="keyping-media-more-badge">{tr(f.gallery.moreBadge, lang)}</span>}
                <figcaption>{tr(item.caption, lang)}</figcaption>
              </figure>
            );
          }
          return null;
        })}
      </div>

      {extra.length > 0 && (
        <div class="keyping-media-hidden" aria-hidden="true">
          {extra.map(({ item, full }) => item.type === 'image' && (
            <figure class:list={['keyping-media', { 'keyping-media--compact': item.compact }]} tabindex="-1" role="button" aria-label={t.lightbox.openMedia}>
              <img src={full[0]} alt={tr(item.alt, lang)} loading="lazy" decoding="async" data-full={full[0]} width={item.src.width} height={item.src.height} />
              <figcaption>{tr(item.caption, lang)}</figcaption>
            </figure>
          ))}
        </div>
      )}
    </div>
  </section>

  <div class="keyping-grid">
    <section class="keyping-section keyping-card">
      <h2 class="keyping-h3">{tr(f.features.title, lang)}</h2>
      <ul class="keyping-list">{f.features.items.map((i) => <li>{tr(i, lang)}</li>)}</ul>
    </section>

    <section class="keyping-section keyping-card">
      <h2 class="keyping-h3">{tr(f.security.title, lang)}</h2>
      <ul class="keyping-list">{f.security.items.map((i) => <li>{tr(i, lang)}</li>)}</ul>
    </section>

    <section class="keyping-section keyping-card">
      <h2 class="keyping-h3">{tr(f.architecture.title, lang)}</h2>
      {f.architecture.stack.map((s) => (
        <p class="keyping-stack-line">
          <span>{tr(s.label, lang)}</span>
          <strong>{tr(s.value, lang)}</strong>
        </p>
      ))}
      <ol class="keyping-flow">{f.architecture.flow.map((i) => <li>{tr(i, lang)}</li>)}</ol>
    </section>

    <section class="keyping-section keyping-card">
      <h2 class="keyping-h3">{tr(f.integrity.title, lang)}</h2>
      <p>{tr(f.integrity.copy, lang)}</p>
      <ul class="keyping-list">{f.integrity.files.map((i) => <li>{tr(i, lang)}</li>)}</ul>
      <p class="keyping-cmd-label">{tr(f.integrity.verifyLabel, lang)}</p>
      <pre class="keyping-code"><code>{f.integrity.command}</code></pre>
    </section>
  </div>

  <section class="keyping-section keyping-section--roadmap">
    <h2 class="keyping-h3">{tr(f.roadmap.title, lang)}</h2>
    <ul class="keyping-list">{f.roadmap.items.map((i) => <li>{tr(i, lang)}</li>)}</ul>
  </section>
</section>
