---
/**
 * Vista de producto estrella (layout "flagship" de la plantilla Proyecto).
 * Componente específico porque tiene más secciones que la plantilla estándar
 * (motivación, señales, galería con visor, seguridad, arquitectura,
 * integridad, roadmap). Todo su contenido sigue en el archivo del módulo.
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { tr, ui, type Locale } from '../../lib/i18n';
import type { ModuleEntry } from '../../lib/modules';
import { localizeMedia } from '../../lib/media';
import PageHeader from '../ui/PageHeader.astro';
import Sec from '../ui/Sec.astro';
import AdoptionFact from '../ui/AdoptionFact.astro';
import StatusTag from '../ui/StatusTag.astro';
import { resolveAdoption } from '../../lib/adoption';

interface Props { module: ModuleEntry; lang: Locale }
const { module, lang } = Astro.props;
if (module.data.template !== 'project' || !module.data.project.flagship) throw new Error('FlagshipProject necesita un proyecto flagship');
const p = module.data.project;
const f = p.flagship!;
const t = ui(lang);
const adoption = resolveAdoption(p.adoption, lang);
const logo = p.cover.fit === 'logo';
const full = async (src: ImageMetadata) => (await getImage({ src, width: Math.min(1920, src.width), format: 'webp', quality: 85 })).src;

type Item = (typeof f.gallery.items)[number];
const media = await Promise.all(
  localizeMedia(f.gallery.items, lang).map(async (item: Item) => ({
    item,
    full: item.type === 'image' ? [await full(item.src)] : item.type === 'composite' ? await Promise.all(item.parts.map((x) => full(x.src))) : [],
  })),
);
const videos = media.filter((x) => x.item.type === 'video');
const stills = media.filter((x) => x.item.type !== 'video');

const toc = [
  { id: 'overview', title: tr(p.description.title, lang) },
  { id: 'why', title: tr(f.why.title, lang) },
  { id: 'signals', title: tr(f.metrics.title, lang) },
  { id: 'gallery', title: tr(f.gallery.title, lang) },
  { id: 'features', title: tr(f.features.title, lang) },
  { id: 'security', title: tr(f.security.title, lang) },
  { id: 'architecture', title: tr(f.architecture.title, lang) },
  { id: 'integrity', title: tr(f.integrity.title, lang) },
  { id: 'roadmap', title: tr(f.roadmap.title, lang) },
];
let n = 0;
---
<article class="page-body page-body--flagship">
  <PageHeader eyebrow={tr(p.header.eyebrow, lang)} title={tr(p.header.title, lang)} lead={tr(p.header.lead, lang)} leadSize="large">
    <p class="phead__punchline">{tr(f.punchline, lang)}</p>
    {f.actions.length > 0 && (
      <div class="actions">
        {f.actions.map((a) => (
          <a class={a.variant === 'download' ? 'btn btn--primary' : 'link-arrow'} href={lang === 'es' && a.urlEs ? a.urlEs : a.url} target="_blank" rel="noopener noreferrer">
            {tr(a.label, lang)} <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    )}
    {p.status && p.status.tone !== 'neutral' && (
      <StatusTag label={tr(p.status.label, lang)} value={tr(p.status.value, lang)} tone={p.status.tone} />
    )}
    <ul class="traits traits--inline">{f.pills.map((pill) => <li>{tr(pill, lang)}</li>)}</ul>
    {logo && <Image slot="icon" class="phead__icon" src={p.cover.src} alt={tr(p.cover.alt, lang)} width={192} loading="eager" />}
    <dl class="spec spec--compact" slot="aside">
      {f.release && <div><dt>{tr(f.release.label, lang)}</dt><dd>{tr(f.release.value, lang)}</dd></div>}
      {p.status && p.status.tone === 'neutral' && <div><dt>{tr(p.status.label, lang)}</dt><dd>{tr(p.status.value, lang)}</dd></div>}
      <div><dt>{tr(p.stackTitle, lang) || 'Stack'}</dt><dd>{p.stack.map((s) => tr(s, lang)).join(' · ')}</dd></div>
      {adoption && <AdoptionFact adoption={adoption} />}
    </dl>
  </PageHeader>

  {!logo && (
    <figure class="figure figure--cover">
      <Image src={p.cover.src} alt={tr(p.cover.alt, lang)} widths={[640, 1280, 1920]} sizes="(max-width: 1180px) 92vw, 1100px" loading="eager" decoding="async" />
    </figure>
  )}

  <nav class="toc" aria-label={t.site.onThisPage}>
    <p class="label">{t.site.onThisPage}</p>
    <ol>
      {toc.map((x, i) => <li><a href={`#${x.id}`}><span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span> {x.title}</a></li>)}
    </ol>
  </nav>

  <Sec id="overview" index={++n} title={toc[0]!.title}>
    <div class="prose prose--large">{p.description.paragraphs.map((para) => <p>{tr(para, lang)}</p>)}</div>
  </Sec>

  <Sec id="why" index={++n} kicker={tr(f.why.subtitle, lang)} title={toc[1]!.title}>
    <p class="sec__lead">{tr(f.why.lead, lang)}</p>
    <dl class="terms">
      {f.why.cards.map((c) => <div><dt>{tr(c.title, lang)}</dt><dd>{tr(c.copy, lang)}</dd></div>)}
    </dl>
    {f.why.focus && (
      <div class="callout">
        <h3 class="callout__title">{tr(f.why.focus.title, lang)}</h3>
        <p>{tr(f.why.focus.copy, lang)}</p>
      </div>
    )}
  </Sec>

  <Sec id="signals" index={++n} kicker={tr(f.metrics.subtitle, lang)} title={toc[2]!.title}>
    <ul class="facts">{f.metrics.items.map((i) => <li>{tr(i, lang)}</li>)}</ul>
    <p class="note">{tr(f.metrics.statement, lang)}</p>
  </Sec>

  <Sec id="gallery" index={++n} title={toc[3]!.title} wide>
    <p class="sec__lead">{tr(f.gallery.lead, lang)}</p>
    <div class="gallery">
      {videos.map(({ item }) => item.type === 'video' && (
        <figure class="shot shot--hero gallery__item" tabindex="0" role="button" aria-label={`${t.lightbox.openMedia}: ${tr(item.alt, lang)}`}>
          <video autoplay muted loop playsinline preload="metadata" aria-label={tr(item.alt, lang)}>
            <source src={item.src} type={item.src.endsWith('.webm') ? 'video/webm' : 'video/mp4'} />
          </video>
          <figcaption>{tr(item.caption, lang)}</figcaption>
        </figure>
      ))}
      <div class="gallery-grid">
        {stills.map(({ item, full }) => {
          if (item.type === 'composite') {
            return (
              <figure class="shot gallery__item" tabindex="0" role="button" aria-label={`${t.lightbox.openMedia}: ${tr(item.caption, lang)}`}>
                <div class="shot__pair gallery__composite">
                  {item.parts.map((part, j) => (
                    <Image src={part.src} alt={tr(part.alt, lang)} widths={[420, 840]} sizes="(max-width: 860px) 46vw, 260px" loading="lazy" decoding="async" data-full={full[j]} />
                  ))}
                </div>
                <figcaption>{tr(item.caption, lang)}</figcaption>
              </figure>
            );
          }
          if (item.type === 'image') {
            return (
              <figure class="shot gallery__item" tabindex="0" role="button" aria-label={`${t.lightbox.openMedia}: ${tr(item.alt, lang)}`}>
                <Image src={item.src} alt={tr(item.alt, lang)} widths={[420, 840]} sizes="(max-width: 860px) 92vw, 520px" loading="lazy" decoding="async" data-full={full[0]} />
                <figcaption>{tr(item.caption, lang)}</figcaption>
              </figure>
            );
          }
          return null;
        })}
      </div>
    </div>
  </Sec>

  <Sec id="features" index={++n} title={toc[4]!.title}>
    <ul class="ruled ruled--cols">{f.features.items.map((i) => <li>{tr(i, lang)}</li>)}</ul>
  </Sec>

  <Sec id="security" index={++n} title={toc[5]!.title}>
    <ul class="ruled">{f.security.items.map((i) => <li>{tr(i, lang)}</li>)}</ul>
  </Sec>

  <Sec id="architecture" index={++n} title={toc[6]!.title}>
    <dl class="spec">
      {f.architecture.stack.map((s) => <div><dt>{tr(s.label, lang)}</dt><dd>{tr(s.value, lang)}</dd></div>)}
    </dl>
    <ol class="flow">{f.architecture.flow.map((i) => <li>{tr(i, lang)}</li>)}</ol>
  </Sec>

  <Sec id="integrity" index={++n} title={toc[7]!.title}>
    <div class="prose"><p>{tr(f.integrity.copy, lang)}</p></div>
    <ul class="tech tech--small">{f.integrity.files.map((i) => <li>{tr(i, lang)}</li>)}</ul>
    <p class="label">{tr(f.integrity.verifyLabel, lang)}</p>
    <pre class="code"><code>{f.integrity.command}</code></pre>
  </Sec>

  <Sec id="roadmap" index={++n} title={toc[8]!.title}>
    <ul class="ruled ruled--todo">{f.roadmap.items.map((i) => <li>{tr(i, lang)}</li>)}</ul>
  </Sec>
</article>
