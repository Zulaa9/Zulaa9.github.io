---
/** Plantilla "Sección genérica": cabecera + bloques (texto, lista, tarjetas, imagen, enlaces). */
import { Image } from 'astro:assets';
import { tr, ui, type Locale } from '../../lib/i18n';
import type { ModuleEntry } from '../../lib/modules';
import PageHeader from '../ui/PageHeader.astro';
import Sec from '../ui/Sec.astro';

interface Props { module: ModuleEntry; lang: Locale }
const { module, lang } = Astro.props;
if (module.data.template !== 'section') throw new Error('SectionTemplate necesita un módulo "section"');
const d = module.data.section;
const t = ui(lang);
const isExternal = (url: string) => /^https?:/i.test(url);
const mailOf = (url: string) => (url.startsWith('mailto:') ? url.slice(7).split('?')[0] : '');
let n = 0;
---
<article class="page-body">
  <PageHeader eyebrow={tr(d.header.eyebrow, lang)} title={tr(d.header.title, lang)} lead={tr(d.header.lead, lang)} leadSize={d.header.leadSize} />

  {d.blocks.map((b) => {
    switch (b.type) {
      case 'cards':
        return (
          <Fragment>
            {b.title && <h2 class="group-title">{tr(b.title, lang)}</h2>}
            {b.cards.map((c) => (
              <Sec index={++n} kicker={c.tag ? tr(c.tag, lang) : undefined} title={tr(c.title, lang)} level={b.title ? 3 : 2}>
                <p class="sec__lead">{tr(c.desc, lang)}</p>
                {c.points.length > 0 && <ul class="ruled">{c.points.map((p) => <li>{tr(p, lang)}</li>)}</ul>}
              </Sec>
            ))}
          </Fragment>
        );
      case 'text':
        if (b.variant === 'closing') {
          return (
            <div class="closing">
              {b.title && <h2 class="closing__title">{tr(b.title, lang)}</h2>}
              {b.paragraphs.map((p) => <p>{tr(p, lang)}</p>)}
            </div>
          );
        }
        if (b.variant === 'lines') {
          return (
            <ul class="meta-lines" aria-label={b.title ? tr(b.title, lang) : undefined}>
              {b.paragraphs.map((p) => <li>{tr(p, lang)}</li>)}
            </ul>
          );
        }
        return (
          <Sec index={b.title ? ++n : undefined} title={b.title ? tr(b.title, lang) : undefined}>
            <div class="prose">{b.paragraphs.map((p) => <p>{tr(p, lang)}</p>)}</div>
          </Sec>
        );
      case 'list':
        return (
          <Sec index={++n} title={tr(b.title, lang)}>
            {b.style === 'chips'
              ? <ul class="tech">{b.items.map((i) => <li>{tr(i, lang)}</li>)}</ul>
              : <ul class="ruled">{b.items.map((i) => <li>{tr(i, lang)}</li>)}</ul>}
          </Sec>
        );
      case 'image':
        return (
          <figure class="figure">
            <Image src={b.src} alt={tr(b.alt, lang)} widths={[480, 960, 1440]} sizes="(max-width: 980px) 92vw, 1100px" loading="lazy" decoding="async" />
            {b.caption && <figcaption>{tr(b.caption, lang)}</figcaption>}
          </figure>
        );
      case 'links':
        return (
          <div class="link-index">
            {b.title && <h2 class="group-title">{tr(b.title, lang)}</h2>}
            <ul>
              {b.links.map((l) => {
                const mail = mailOf(l.url);
                return (
                  <li class="link-row">
                    <a class="link-row__main" href={l.url} {...(isExternal(l.url) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                      <span class="link-row__label">{tr(l.label, lang)}</span>
                      {l.subtitle && <span class="link-row__sub">{tr(l.subtitle, lang)}</span>}
                      <span class="link-row__arrow" aria-hidden="true">{isExternal(l.url) ? '↗' : '→'}</span>
                    </a>
                    {mail && (
                      <button class="copy-btn" type="button" data-copy={mail} data-copied-label={t.site.copied} aria-label={t.site.copyEmail}>
                        <span class="copy-btn__value">{mail}</span>
                        <span class="copy-btn__state" aria-live="polite">{t.site.copy}</span>
                      </button>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        );
    }
  })}
</article>
