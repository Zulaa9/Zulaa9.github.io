---
import { Image } from 'astro:assets';
import { tr, localePath, type Locale } from '../../lib/i18n';
import type { ModuleEntry } from '../../lib/modules';
import PageHeader from '../ui/PageHeader.astro';
import Sec from '../ui/Sec.astro';

interface Props { module: ModuleEntry; all: ModuleEntry[]; lang: Locale }
const { module, all, lang } = Astro.props;
if (module.data.template !== 'about') throw new Error('AboutTemplate necesita un módulo "about"');
const d = module.data.about;
const contact = d.nextStep ? all.find((m) => m.id === d.nextStep!.contactModule && m.data.visible) : undefined;
let n = 0;
---
<article class="page-body">
  <PageHeader eyebrow={tr(d.header.eyebrow, lang)} title={tr(d.header.title, lang)} lead={tr(d.header.lead, lang)} leadSize="large">
    <div class="prose">
      {d.header.paragraphs.map((p) => <p>{tr(p, lang)}</p>)}
    </div>
    {d.nextStep && (contact || d.nextStep.cvUrl) && (
      <div class="actions" aria-label={tr(d.nextStep.title, lang)} role="group">
        {contact && (
          <a class="btn btn--primary" href={`${localePath(lang, contact.data.path)}?from=${module.id}`}>{tr(d.nextStep.contactLabel, lang)} <span aria-hidden="true">→</span></a>
        )}
        {d.nextStep.cvLabel && d.nextStep.cvUrl && (
          <a class="link-arrow" href={d.nextStep.cvUrl} target="_blank" rel="noopener noreferrer">{tr(d.nextStep.cvLabel, lang)} <span aria-hidden="true">↗</span></a>
        )}
      </div>
    )}
    {d.photo && (
      <figure class="portrait" slot="aside">
        <Image src={d.photo.src} alt={tr(d.photo.alt, lang)} widths={[320, 480, 640]} sizes="(max-width: 860px) 60vw, 320px" loading="eager" decoding="async" />
      </figure>
    )}
  </PageHeader>

  <Sec index={++n} title={tr(d.experience.title, lang)}>
    <ol class="entries">
      {d.experience.items.map((item) => (
        <li class="entry">
          <p class="entry__date">{tr(item.date, lang)}</p>
          <h3 class="entry__title">{tr(item.role, lang)}</h3>
          <p class="entry__copy">{tr(item.copy, lang)}</p>
          {item.highlight && (
            <p class="entry__note"><span>{tr(item.highlight.label, lang)}</span> {tr(item.highlight.value, lang)}</p>
          )}
        </li>
      ))}
    </ol>
  </Sec>

  <Sec index={++n} title={tr(d.focus.title, lang)}>
    <ul class="ruled">{d.focus.items.map((i) => <li>{tr(i, lang)}</li>)}</ul>
  </Sec>

  <Sec index={++n} title={tr(d.primarySkills.title, lang)}>
    <ul class="tech tech--primary">{d.primarySkills.items.map((i) => <li>{tr(i, lang)}</li>)}</ul>
    <p class="label">{tr(d.secondarySkills.title, lang)}</p>
    <ul class="tech">{d.secondarySkills.items.map((i) => <li>{tr(i, lang)}</li>)}</ul>
  </Sec>

  {d.closing && <p class="closing">{tr(d.closing, lang)}</p>}
</article>
