---
/**
 * Marco de una página de módulo: la "pantalla" del sistema, con la ruta tipo
 * explorador de archivos arriba (volver + / CORE / MÓDULO) y el contenido con
 * scroll propio dentro.
 */
import type { Crumb } from '../lib/modules';

interface Props {
  crumbs: Crumb[];
  currentId: string;
  backHref: string;
  backLabel: string;
  pathLabel: string;
  expandLabel: string;
  collapseLabel: string;
}
const { crumbs, currentId, backHref, backLabel, pathLabel, expandLabel, collapseLabel } = Astro.props;
const withFrom = (href: string) => `${href}?from=${currentId}`;
---
<script is:inline>
  // Antes de pintar: si la ventana estaba ampliada en esta sesión, se abre ya ampliada y sin animación.
  try {
    if (sessionStorage.getItem('zula:screen-expanded') === '1') {
      const h = sessionStorage.getItem('zula:topbar-h');
      if (h) document.documentElement.style.setProperty('--topbar-h', h);
      document.documentElement.classList.add('screen-expanded', 'screen-noanim');
    }
  } catch {}
</script>
<div class="core-stage screen" id="main-content" tabindex="-1">
  <nav class="crumbbar" aria-label={pathLabel}>
    <a href={backHref} class="back-button" id="back-to-core-link" aria-label={backLabel}>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5L8 12L15 19" /></svg>
    </a>
    <ol class="crumbs">
      {crumbs.map((c) => (
        <li>{c.href ? <a href={withFrom(c.href)}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
      ))}
    </ol>
    <button
      type="button"
      class="screen-toggle"
      id="screen-toggle"
      aria-pressed="false"
      aria-label={expandLabel}
      title={expandLabel}
      data-label-expand={expandLabel}
      data-label-collapse={collapseLabel}
    >
      <svg class="screen-toggle__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <rect class="screen-toggle__frame" x="3.5" y="3.5" width="17" height="17" rx="3" />
        <rect class="screen-toggle__window" x="8" y="8" width="8" height="8" rx="1.5" />
        <g class="screen-toggle__arrow screen-toggle__arrow--tr"><path d="M14.5 4.5h5v5" /><path d="M19.5 4.5l-4.5 4.5" /></g>
        <g class="screen-toggle__arrow screen-toggle__arrow--bl"><path d="M9.5 19.5h-5v-5" /><path d="M4.5 19.5l4.5-4.5" /></g>
      </svg>
      <span class="screen-toggle__label" aria-hidden="true">
        <span class="screen-toggle__text screen-toggle__text--expand">{expandLabel}</span>
        <span class="screen-toggle__text screen-toggle__text--collapse">{collapseLabel}</span>
      </span>
    </button>
  </nav>
  <div class="screen__scroll" tabindex="0">
    <div class="page">
      <slot />
    </div>
  </div>
</div>
