---
/** Marco de una página de módulo: ruta (volver + migas) y contenido. */
import type { Crumb } from '../lib/modules';

interface Props {
  crumbs: Crumb[];
  currentId: string;
  backHref: string;
  backLabel: string;
  pathLabel: string;
}
const { crumbs, currentId, backHref, backLabel, pathLabel } = Astro.props;
const withFrom = (href: string) => `${href}?from=${currentId}`;
---
<div class="page" id="main-content" tabindex="-1">
  <nav class="crumbbar" aria-label={pathLabel}>
    <a href={backHref} class="back-button" id="back-to-core-link">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5L8 12L15 19" /></svg>
      <span>{backLabel}</span>
    </a>
    <ol class="crumbs">
      {crumbs.map((c) => (
        <li>{c.href ? <a href={withFrom(c.href)}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
      ))}
    </ol>
  </nav>
  <slot />
</div>
