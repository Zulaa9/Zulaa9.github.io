---
// Fase 2 QA page: proves the content collections parse + validate against
// the Zod schemas in src/content/config.ts, and that astro:assets actually
// optimizes the referenced cover images (not just resolves the path).
// Not linked from anywhere, noindex'd — remove or gate before going live.
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";

const graphNodes = await getCollection("graph");
const projects = await getCollection("projects");

const byId = new Map(graphNodes.map((n) => [n.id, n]));
function pathToCore(id: string): string[] {
  const path = [id];
  let current = byId.get(id);
  while (current?.data.parentId) {
    path.unshift(current.data.parentId);
    current = byId.get(current.data.parentId);
  }
  return path;
}
---

<BaseLayout title="Content QA | Debug" description="Fase 2 content collection debug view.">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <section class="debug">
    <h1>Content collections — {graphNodes.length} graph nodes, {projects.length} projects</h1>

    <h2>Graph topology</h2>
    <table>
      <thead>
        <tr><th>id</th><th>type</th><th>order / pinned</th><th>path to core</th><th>route</th></tr>
      </thead>
      <tbody>
        {graphNodes.map((node) => (
          <tr>
            <td>{node.id}</td>
            <td>{node.data.type}</td>
            <td>{node.data.order ?? "—"}{node.data.pinned ? " · pinned" : ""}</td>
            <td>{pathToCore(node.id).join(" → ")}</td>
            <td>{node.data.route ?? "—"}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h2>Projects</h2>
    <ul class="project-list">
      {projects.map((project) => (
        <li>
          {project.data.cover && (
            <Image src={project.data.cover} alt="" width={96} height={96} />
          )}
          <div>
            <strong>{project.data.en.title}</strong> — {project.data.status}
            {project.data.isFlagship ? " · flagship" : ""}
            <br />
            <span>{project.data.en.shortDescription}</span>
            <br />
            <em>stack: {project.data.stack.join(", ") || "—"}</em>
          </div>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .debug {
    margin-top: 32px;
    max-width: 900px;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    margin: 12px 0 32px;
    font-size: 0.85rem;
  }
  th, td {
    border: 1px solid rgba(130, 171, 207, 0.25);
    padding: 6px 10px;
    text-align: left;
  }
  .project-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .project-list li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    border: 1px solid rgba(130, 171, 207, 0.2);
    border-radius: 12px;
    padding: 10px;
  }
  .project-list img {
    border-radius: 8px;
    object-fit: cover;
  }
  .project-list span, .project-list em {
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
