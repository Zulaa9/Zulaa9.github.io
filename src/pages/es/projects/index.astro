---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const locale = "es" as const;
const entries = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99),
);
---

<BaseLayout title="Proyectos | Núcleo del Sistema" description="Galería de proyectos de Unax Zulaika Fuente.">
  <section class="projects">
    <p class="eyebrow">ENTREGABLES</p>
    <h1>Proyectos</h1>
    <p class="lead">La plantilla completa llega en la Fase 4 — esto ya lee la colección real de proyectos.</p>
    <ul class="grid">
      {entries.map((project) => (
        <li class:list={["card", { "card--flagship": project.data.isFlagship }]}>
          {project.data.cover && <Image src={project.data.cover} alt="" width={280} height={160} />}
          <p class="card__status">{project.data.status}</p>
          <h2><a href={`/es/projects/${project.id}`}>{project.data[locale].title}</a></h2>
          <p>{project.data[locale].shortDescription}</p>
          {project.data.stack.length > 0 && <p class="card__stack">{project.data.stack.join(" · ")}</p>}
        </li>
      ))}
    </ul>
    <a class="back-link" href="/es/">← Volver al Core</a>
  </section>
</BaseLayout>

<style>
  .projects { margin-top: 32px; max-width: 900px; }
  .projects h1 { font-family: var(--font-display); font-size: clamp(1.2rem, 2vw, 1.72rem); margin: 10px 0; }
  .lead { color: #bfd0df; font-size: 0.92rem; margin-bottom: 24px; }
  .grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }
  .card { border: 1px solid rgba(130, 171, 207, 0.22); border-radius: 14px; padding: 14px; background: var(--panel); }
  .card--flagship { border-color: rgba(83, 198, 224, 0.6); }
  .card img { border-radius: 8px; width: 100%; height: auto; margin-bottom: 8px; }
  .card__status { text-transform: uppercase; font-size: 0.66rem; letter-spacing: 0.1em; color: var(--muted); margin: 0 0 4px; }
  .card h2 { font-family: var(--font-display); font-size: 1rem; margin: 0 0 6px; }
  .card h2 a { color: var(--text); text-decoration: none; }
  .card h2 a:hover, .card h2 a:focus-visible { color: var(--accent-strong); }
  .card p { margin: 0 0 6px; font-size: 0.85rem; color: #bfd0df; }
  .card__stack { color: var(--muted); font-size: 0.75rem; }
  .back-link { display: inline-block; margin-top: 24px; color: var(--accent-strong); text-decoration: none; }
  .back-link:hover, .back-link:focus-visible { text-decoration: underline; }
</style>
