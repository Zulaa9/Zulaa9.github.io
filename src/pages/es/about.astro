---
import { Image } from "astro:assets";
import ModuleLayout from "../../layouts/ModuleLayout.astro";
import { aboutUi } from "../../i18n/about-ui";
import profilePhoto from "../../assets/profile/zula.png";

const t = aboutUi.es;
---

<ModuleLayout
  title={t.pageTitle}
  description={t.pageDescription}
  crumbs={[{ label: t.crumbCore, href: "/es/" }, { label: t.crumbAbout }]}
  backHref="/es/"
  backLabel="Volver al core"
>
  <header class="module-header about-intro">
    <div class="about-copy">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1>{t.title}</h1>
      <p class="about-lead">{t.lead}</p>
      <p>{t.copy1}</p>
      <p>{t.copy2}</p>
      <a class="text-link" href="/es/contact">{t.linksContact} →</a>
    </div>
    <figure class="about-photo">
      <Image src={profilePhoto} alt="Unax Zulaika Fuente" width={480} height={300} />
    </figure>
  </header>

  <section class="section">
    <h2>{t.experienceTitle}</h2>
    <p class="section-meta">{t.experienceRole} · {t.experienceDate}</p>
    <p>{t.experienceCopy}</p>
    <dl class="spec">
      <div><dt>{t.experienceCurrentLabel}</dt><dd>{t.experienceCurrentValue}</dd></div>
    </dl>
  </section>

  <section class="section">
    <h2>{t.focusTitle}</h2>
    <ul class="plain-list">
      {t.focusItems.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="section">
    <h2>{t.coreTechTitle}</h2>
    <ul class="inline-list">
      {t.coreTechItems.map((item) => <li>{item}</li>)}
    </ul>
    <p class="eyebrow also-worked-label">{t.alsoWorkedTitle}</p>
    <ul class="inline-list">
      {t.alsoWorkedItems.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <hr class="section-divider" />
  <p class="closing-line">{t.closing}</p>
</ModuleLayout>

<style>
  .about-intro {
    display: grid;
    column-gap: 40px;
    align-items: start;
    grid-template-columns: minmax(0, 1fr) clamp(240px, 26vw, 320px);
  }

  .about-copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .about-lead {
    font-size: 1.05rem;
    color: #e5f4ff !important;
  }

  .text-link {
    align-self: flex-start;
    margin-top: 18px;
    color: var(--text);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.86rem;
    border-bottom: 1px solid rgba(130, 171, 207, 0.4);
    padding-bottom: 2px;
  }

  .text-link:hover,
  .text-link:focus-visible {
    color: var(--accent-strong);
    border-color: var(--accent-strong);
  }

  .about-photo {
    margin: 0;
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 1px solid rgba(132, 180, 207, 0.3);
    border-radius: 14px;
    overflow: hidden;
    background: rgba(8, 16, 24, 0.72);
  }

  .about-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 30%;
  }

  .also-worked-label {
    margin: 20px 0 8px;
  }

  .closing-line {
    margin: 0;
    max-width: 62ch;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .about-intro {
      grid-template-columns: 1fr;
      column-gap: 0;
    }

    .about-photo {
      width: min(100%, 280px);
      aspect-ratio: 16 / 10;
      margin-top: 18px;
    }
  }
</style>
