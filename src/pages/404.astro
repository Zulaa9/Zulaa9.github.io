---
/**
 * Página 404 única (los servidores estáticos sirven un solo 404.html).
 * Se genera en inglés y en español; un script decide cuál mostrar según la
 * URL pedida (/es/…) o la preferencia guardada.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath, ui, LOCALES } from '../lib/i18n';
import sectionCss from '../styles/section.css?url';
import sharedCss from '../styles/shared.css?url';

const en = ui('en');
---
<BaseLayout lang="en" title={en.notFound.title} description={en.notFound.description} path={null} bodyClass="section-page is-section-ready" shellLabel="404">
  <Fragment slot="head">
    <link rel="stylesheet" href={sectionCss} />
    <link rel="stylesheet" href={sharedCss} />
    <style is:inline>html[lang="es"] [data-only="en"], html[lang="en"] [data-only="es"] { display: none; }</style>
    <script is:inline>
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('system_core_lang'); } catch (e) {}
        var es = location.pathname.indexOf('/es/') === 0 || location.pathname === '/es' || (stored === 'es' && location.pathname.indexOf('/en/') !== 0);
        if (es) { document.documentElement.lang = 'es'; document.title = 'Módulo no encontrado | Núcleo del Sistema'; }
      })();
    </script>
  </Fragment>
  <div class="core-stage section-stage" id="main-content" tabindex="-1">
    <div class="section-scroll">
      <section class="section-shell">
        {LOCALES.map((l) => {
          const t = ui(l);
          return (
            <div data-only={l} lang={l}>
              <header class="section-header">
                <p class="eyebrow">{t.notFound.eyebrow}</p>
                <h1>{t.notFound.heading}</h1>
                <p class="section-lead">{t.notFound.copy}</p>
              </header>
              <section class="block-box block-text--lines">
                <a class="block-text__line" href={localePath(l)}>{t.notFound.cta}</a>
              </section>
            </div>
          );
        })}
      </section>
    </div>
  </div>
</BaseLayout>
