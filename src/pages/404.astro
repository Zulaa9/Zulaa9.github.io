---
/**
 * Página 404 única (los servidores estáticos sirven un solo 404.html).
 * Se genera en inglés y en español; un script decide cuál mostrar según la
 * URL pedida (/es/…) o la preferencia guardada.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath, ui, LOCALES } from '../lib/i18n';
import pageCss from '../styles/page.css?url';

const en = ui('en');
---
<BaseLayout lang="en" title={en.notFound.title} description={en.notFound.description} path={null} bodyClass="page-shell" shellLabel="404">
  <Fragment slot="head">
    <link rel="stylesheet" href={pageCss} />
    <style is:inline>html[lang="es"] [data-only="en"], html[lang="en"] [data-only="es"] { display: none; }</style>
    <script is:inline>
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('system_core_lang'); } catch (e) {}
        var es = location.pathname.indexOf('/es/') === 0 || location.pathname === '/es' || (stored === 'es' && location.pathname.indexOf('/en/') !== 0);
        if (es) { document.documentElement.lang = 'es'; document.title = 'Módulo no encontrado | Núcleo del Sistema'; }
      })();
    </script>
  </Fragment>
  <div class="core-stage screen" id="main-content" tabindex="-1">
  <div class="screen__scroll">
  <div class="page">
    {LOCALES.map((l) => {
      const t = ui(l);
      return (
        <div data-only={l} lang={l}>
          <header class="phead">
            <div class="phead__main">
              <p class="kicker">{t.notFound.eyebrow}</p>
              <h1 class="phead__title">{t.notFound.heading}</h1>
              <p class="phead__lead">{t.notFound.copy}</p>
              <div class="actions">
                <a class="btn btn--primary" href={localePath(l)}>{t.notFound.cta} <span aria-hidden="true">→</span></a>
              </div>
            </div>
          </header>
        </div>
      );
    })}
  </div>
  </div>
  </div>
</BaseLayout>
