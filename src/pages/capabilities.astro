---
import ModuleLayout from "../layouts/ModuleLayout.astro";
import { capabilitiesUi } from "../i18n/capabilities-ui";

const t = capabilitiesUi.en;
---

<ModuleLayout
  title={t.pageTitle}
  description={t.pageDescription}
  crumbs={[
    { label: t.crumbCore, href: "/" },
    { label: t.crumbAbout, href: "/about" },
    { label: t.crumbCapabilities },
  ]}
  backHref="/"
  backLabel="Back to core"
>
  <header class="module-header">
    <p class="eyebrow">{t.eyebrow}</p>
    <h1>{t.title}</h1>
    <p>{t.lead}</p>
  </header>

  {t.cards.map((card, i) => (
    <section class="section capability">
      <p class="eyebrow capability-tag">{card.tag} · {String(i + 1).padStart(2, "0")}</p>
      <h2>{card.title}</h2>
      <p>{card.desc}</p>
      <ul class="plain-list">
        {card.points.map((point) => <li>{point}</li>)}
      </ul>
    </section>
  ))}

  <hr class="section-divider" />
  <p class="closing-line">{t.closing}</p>
</ModuleLayout>

<style>
  .capability-tag {
    margin: -6px 0 4px;
  }

  /* Six similarly-shaped blocks in a row need a stronger seam than plain
   * whitespace to stay scannable — a hairline, not a box around each. */
  .capability + .capability {
    margin-top: 0;
    padding-top: 40px;
    border-top: 1px solid rgba(130, 171, 207, 0.16);
  }

  .closing-line {
    margin: 0;
    max-width: 62ch;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }
</style>
