---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Capabilities | System Core" description="Engineering capabilities of Unax Zulaika Fuente.">
  <article class="placeholder">
    <p class="eyebrow">ENGINEERING</p>
    <h1>Capabilities lands in Fase 4.</h1>
    <p>This route exists so the graph's navigation is real today — full content and layout come with the project templates.</p>
    <a class="back-link" href="/">← Back to Core</a>
  </article>
</BaseLayout>

<style>
  .placeholder { margin-top: 40px; max-width: 560px; }
  .placeholder h1 { font-family: var(--font-display); font-size: clamp(1.2rem, 2vw, 1.72rem); margin: 10px 0; }
  .placeholder p:not(.eyebrow) { color: #bfd0df; line-height: 1.52; font-size: 0.92rem; }
  .back-link { display: inline-block; margin-top: 16px; color: var(--accent-strong); text-decoration: none; }
  .back-link:hover, .back-link:focus-visible { text-decoration: underline; }
</style>
