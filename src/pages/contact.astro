---
import ModuleLayout from "../layouts/ModuleLayout.astro";
import { contactUi } from "../i18n/contact-ui";

const t = contactUi.en;
---

<ModuleLayout
  title={t.pageTitle}
  description={t.pageDescription}
  crumbs={[
    { label: t.crumbCore, href: "/" },
    { label: t.crumbAbout, href: "/about" },
    { label: t.crumbContact },
  ]}
  backHref="/"
  backLabel="Back to core"
>
  <header class="module-header">
    <p class="eyebrow">{t.eyebrow}</p>
    <h1>{t.title}</h1>
    <p>{t.lead}</p>
  </header>

  <section class="section">
    <ul class="channel-list" aria-label="Contact channels">
      <li>
        <a href="mailto:unax.zulaika.fuente@gmail.com">
          <span class="channel-label">{t.emailTitle}</span>
          <span class="channel-value">{t.emailSubtitle}</span>
        </a>
      </li>
      <li>
        <a href="https://github.com/Zulaa9" target="_blank" rel="noopener noreferrer">
          <span class="channel-label">{t.githubTitle}</span>
          <span class="channel-value">{t.githubSubtitle}</span>
        </a>
      </li>
      <li>
        <a href="https://www.linkedin.com/in/unax-zulaika-fuente/" target="_blank" rel="noopener noreferrer">
          <span class="channel-label">{t.linkedinTitle}</span>
          <span class="channel-value">{t.linkedinSubtitle}</span>
        </a>
      </li>
    </ul>
  </section>

  <dl class="spec">
    <div><dt>{t.locationLabel}</dt><dd>{t.location}</dd></div>
    <div><dt>{t.remoteLabel}</dt><dd>{t.remote}</dd></div>
  </dl>
</ModuleLayout>
