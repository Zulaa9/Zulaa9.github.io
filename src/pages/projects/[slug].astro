---
import { getCollection } from "astro:content";
import ProjectLayout from "../../layouts/ProjectLayout.astro";

export async function getStaticPaths() {
  const entries = (await getCollection("projects", ({ data }) => !data.draft)).sort(
    (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99),
  );
  return entries.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, index: i + 1 } }));
}

const { entry, index } = Astro.props;
---

<ProjectLayout entry={entry} locale="en" index={index} />
