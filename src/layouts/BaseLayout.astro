---
import { ClientRouter } from "astro:transitions";
import { getImage } from "astro:assets";
import Backdrop from "../components/shared/Backdrop.astro";
import Topbar from "../components/shared/Topbar.astro";
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Defaults to the site's shared social-preview image when omitted. */
  ogImage?: ImageMetadata;
  /** "website" for regular pages, "article" for project pages. */
  ogType?: "website" | "article";
  /** Core page only — see Backdrop.astro's `gated` prop. */
  backdropGated?: boolean;
}

const { title, description, ogImage, ogType = "website", backdropGated = false } = Astro.props;
const locale = Astro.currentLocale ?? "en";

// --- SEO: canonical + hreflang alternates ---
// Routing is prefixDefaultLocale:false (en at "/", es at "/es/…"), so the
// sibling-locale path is a straightforward prefix add/strip.
const pathname = Astro.url.pathname;
const isEs = pathname === "/es" || pathname.startsWith("/es/");
const enPath = isEs ? pathname.replace(/^\/es/, "") || "/" : pathname;
const esPath = isEs ? pathname : "/es" + (pathname === "/" ? "" : pathname);
const canonicalPath = locale === "es" ? esPath : enPath;
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url.origin);
const enUrl = new URL(enPath, Astro.site ?? Astro.url.origin);
const esUrl = new URL(esPath, Astro.site ?? Astro.url.origin);

const resolvedOgImage = ogImage
  ? await getImage({ src: ogImage, width: 1200, height: 630 })
  : null;
const ogImageUrl = resolvedOgImage ? new URL(resolvedOgImage.src, Astro.site ?? Astro.url.origin) : null;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locale === "es" ? "es_ES" : "en_US"} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <Backdrop gated={backdropGated} />
    <main class="app">
      <section class="system-shell">
        <Topbar />
        <slot />
      </section>
    </main>

    <script>
      // The native View Transitions API occasionally rejects its own
      // internal ready/finished promise with "InvalidStateError: Transition
      // was aborted" when a transition gets superseded (fast back/forward,
      // a second navigation before the first settles, or — as observed in
      // dev — an HMR reconnect landing mid-transition). The navigation
      // itself still completes correctly; only the decorative animation is
      // skipped. Known browser-API race, not app state we can prevent —
      // scoped narrowly so it doesn't surface as an unhandled rejection for
      // something the user never actually sees fail.
      window.addEventListener("unhandledrejection", (event) => {
        if (event.reason instanceof DOMException && event.reason.name === "InvalidStateError") {
          event.preventDefault();
        }
      });
    </script>
  </body>
</html>
