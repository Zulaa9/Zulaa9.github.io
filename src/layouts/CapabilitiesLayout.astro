---
import ModuleLayout from "./ModuleLayout.astro";
import ModuleIntro from "../components/module/ModuleIntro.astro";
import { capabilitiesUi } from "../i18n/capabilities-ui";

interface Props {
  locale: "en" | "es";
}

const { locale } = Astro.props;
const t = capabilitiesUi[locale];

const localePrefix = locale === "es" ? "/es" : "";
const coreHref = locale === "es" ? "/es/" : "/";
const aboutHref = `${localePrefix}/about`;
---

<ModuleLayout
  title={t.pageTitle}
  description={t.pageDescription}
  crumbs={[
    { label: t.crumbCore, href: coreHref },
    { label: t.crumbAbout, href: aboutHref },
    { label: t.crumbCapabilities },
  ]}
  backHref={coreHref}
  backLabel={locale === "es" ? "Volver al core" : "Back to core"}
>
  <article class="capabilities">
    <ModuleIntro statement={t.title} lead={t.lead} />

    <div class="matrix">
      {t.cards.map((card, i) => (
        <div class="matrix__cell">
          <div class="matrix__cell-head">
            <span class="matrix__index">{String(i + 1).padStart(2, "0")}</span>
            <span class="matrix__tag">{card.tag}</span>
          </div>
          <h2 class="matrix__title">{card.title}</h2>
          <p class="matrix__desc">{card.desc}</p>
          <ul class="matrix__points">
            {card.points.map((point) => <li>{point}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <p class="closing-line">{t.closing}</p>
  </article>
</ModuleLayout>

<style>
  .capabilities .matrix {
    margin-top: 8px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid rgba(130, 171, 207, 0.2);
    border-left: 1px solid rgba(130, 171, 207, 0.2);
  }

  .matrix__cell {
    padding: 26px 26px 28px;
    border-right: 1px solid rgba(130, 171, 207, 0.2);
    border-bottom: 1px solid rgba(130, 171, 207, 0.2);
  }

  /* Barely-there row banding — depth without a card: the whole row reads a
   * half-step brighter, not a boxed tile. */
  .matrix__cell:nth-child(-n + 3) {
    background: rgba(255, 255, 255, 0.012);
  }

  .matrix__cell-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  .matrix__index {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--accent);
  }

  .matrix__tag {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: right;
  }

  .matrix__title {
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    line-height: 1.2;
    color: var(--text);
  }

  .matrix__desc {
    margin: 0 0 18px;
    max-width: 40ch;
    color: #c4d9ea;
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .matrix__points {
    margin: 0;
    padding: 14px 0 0;
    border-top: 1px solid rgba(130, 171, 207, 0.14);
    list-style: none;
    display: grid;
    gap: 7px;
  }

  .matrix__points li {
    position: relative;
    max-width: 44ch;
    padding-left: 14px;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .matrix__points li::before {
    content: "\2014";
    position: absolute;
    left: 0;
    color: rgba(130, 171, 207, 0.5);
  }

  .closing-line {
    margin: 40px 0 0;
    max-width: 62ch;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (max-width: 1100px) {
    .capabilities .matrix {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .matrix__cell:nth-child(-n + 3) {
      background: none;
    }

    .matrix__cell:nth-child(4n + 1),
    .matrix__cell:nth-child(4n + 2) {
      background: rgba(255, 255, 255, 0.012);
    }
  }

  @media (max-width: 700px) {
    .capabilities .matrix {
      grid-template-columns: 1fr;
    }

    .matrix__cell:nth-child(4n + 1),
    .matrix__cell:nth-child(4n + 2) {
      background: none;
    }

    .matrix__cell:nth-child(odd) {
      background: rgba(255, 255, 255, 0.012);
    }
  }
</style>
