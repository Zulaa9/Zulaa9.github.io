---
import ModuleLayout from "./ModuleLayout.astro";
import ModuleIntro from "../components/module/ModuleIntro.astro";
import SectionRule from "../components/module/SectionRule.astro";
import { contactUi } from "../i18n/contact-ui";

interface Props {
  locale: "en" | "es";
}

const { locale } = Astro.props;
const t = contactUi[locale];

const localePrefix = locale === "es" ? "/es" : "";
const coreHref = locale === "es" ? "/es/" : "/";
const aboutHref = `${localePrefix}/about`;
---

<ModuleLayout
  title={t.pageTitle}
  description={t.pageDescription}
  crumbs={[
    { label: t.crumbCore, href: coreHref },
    { label: t.crumbAbout, href: aboutHref },
    { label: t.crumbContact },
  ]}
  backHref={coreHref}
  backLabel={locale === "es" ? "Volver al core" : "Back to core"}
>
  <article class="contact">
    <p class="eyebrow contact-tag">{t.title}</p>
    <ModuleIntro statement={t.lead} />

    <ul class="channels" aria-label={locale === "es" ? "Canales de contacto" : "Contact channels"}>
      <li>
        <a class="channel" href="mailto:unax.zulaika.fuente@gmail.com">
          <span class="channel__label">{t.emailTitle}</span>
          <span class="channel__value">{t.emailValue}</span>
          <span class="channel__action">
            <span>{t.emailSubtitle}</span>
            <span class="channel__arrow" aria-hidden="true">↗</span>
          </span>
        </a>
      </li>
      <li>
        <a class="channel" href="https://github.com/Zulaa9" target="_blank" rel="noopener noreferrer">
          <span class="channel__label">{t.githubTitle}</span>
          <span class="channel__value">{t.githubValue}</span>
          <span class="channel__action">
            <span>{t.githubSubtitle}</span>
            <span class="channel__arrow" aria-hidden="true">↗</span>
          </span>
        </a>
      </li>
      <li>
        <a class="channel" href="https://www.linkedin.com/in/unax-zulaika-fuente/" target="_blank" rel="noopener noreferrer">
          <span class="channel__label">{t.linkedinTitle}</span>
          <span class="channel__value">{t.linkedinValue}</span>
          <span class="channel__action">
            <span>{t.linkedinSubtitle}</span>
            <span class="channel__arrow" aria-hidden="true">↗</span>
          </span>
        </a>
      </li>
    </ul>

    <section class="section">
      <SectionRule title={t.contactDetailsTitle} />
      <dl class="spec">
        <div><dt>{t.locationLabel}</dt><dd>{t.location}</dd></div>
        <div><dt>{t.remoteLabel}</dt><dd>{t.remote}</dd></div>
        <div>
          <dt>{t.openToLabel}</dt>
          <dd>
            <ul class="plain-list">
              {t.openToItems.map((item) => <li>{item}</li>)}
            </ul>
          </dd>
        </div>
      </dl>
    </section>
  </article>
</ModuleLayout>

<style>
  /* No cap on the article itself — the composition uses the shell's full
   * width the same way About's hero does; each piece below caps its own
   * part instead. The previous 46rem cap was the actual bug: it squeezed
   * a page's worth of composition into a viewport-agnostic narrow column
   * regardless of how wide the shell around it actually was. */

  .contact-tag {
    margin: 0 0 10px;
  }

  /* Still the sentence itself (ModuleIntro's statement prop, unchanged),
   * still the biggest thing on the page — just wide enough to settle
   * into two intentional lines at wide viewports instead of the shared
   * 22ch default's many short, forced ones. */
  .contact :global(.module-statement) {
    max-width: 50ch;
  }

  /* Channels: the page's three real endpoints, given room to be the
   * composition's second major piece — three unnumbered columns divided
   * by hairlines, deliberately not a numbered matrix (that's
   * Capabilities' language, not this page's) and not cards.
   *
   * The hairline above sits close under the statement (32px, down from
   * 48px) so it reads as this same composition continuing, not a second
   * block starting after a pause — the statement's own 18px margin
   * collapses into that gap the normal block-margin way, same as any
   * other pair of block siblings here.
   *
   * Columns are no longer equal 1fr: measured against the actual
   * rendered strings at this font (canvas.measureText, not eyeballed),
   * GitHub's handle is ~40% narrower than Email's and LinkedIn's is the
   * widest of the three — 1fr / 0.85fr / 1.15fr gives LinkedIn the extra
   * room it actually uses and keeps GitHub from sitting in a track sized
   * for a much longer string it doesn't have. */
  .channels {
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 0.85fr 1.15fr;
    column-gap: 28px;
    border-top: 1px solid rgba(130, 171, 207, 0.2);
  }

  /* A real grid column-gap (not a margin trick on .channel) so this
   * grid's track boundaries are constructed identically to .spec's below
   * — the two line up because they share the same column math, not
   * because of hand-tuned pixel offsets between two different systems. */
  .channel {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 22px 0 24px;
    color: var(--text);
    text-decoration: none;
  }

  /* Vertical dividers between channels: inset top/bottom instead of
   * running the column's full height, so they read as a structural seam
   * between three related pieces rather than a table's column rule.
   * Centered in the column-gap gutter (half of 28px). */
  .channels li:not(:first-child) .channel::after {
    content: "";
    position: absolute;
    left: -14px;
    top: 10px;
    bottom: 10px;
    width: 1px;
    background: rgba(130, 171, 207, 0.16);
  }

  /* The seam that activates on hover/focus — same idea as the shared
   * .channel-row's own hover seam (a hairline that lights up rather than
   * a highlighted box), rotated to sit above a column instead of under a
   * row, since these are columns now, not stacked rows. */
  .channel::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 1px;
    background: transparent;
    transition: background 200ms ease;
  }

  .channel:hover::before,
  .channel:focus-visible::before {
    background: var(--accent-strong);
  }

  .channel__label {
    margin: 0 0 8px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8eb5d1;
  }

  /* The value is the block's real payload — sized and weighted to
   * dominate the action line below it, not just edge it out slightly. */
  .channel__value {
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.1rem, 1.7vw, 1.4rem);
    line-height: 1.28;
    color: var(--text);
    overflow-wrap: break-word;
    transition: color 200ms ease;
  }

  .channel:hover .channel__value,
  .channel:focus-visible .channel__value {
    color: var(--accent-strong);
  }

  /* Pinned to the bottom of the column via margin-top: auto, so all
   * three actions sit on one baseline regardless of label/value height —
   * dimmer and smaller than the value, clearly secondary but still
   * comfortably legible. */
  .channel__action {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: auto;
    font-size: 0.8rem;
    color: var(--muted);
    opacity: 0.82;
  }

  .channel__arrow {
    transition: transform 200ms ease, color 200ms ease;
  }

  .channel:hover .channel__arrow,
  .channel:focus-visible .channel__arrow {
    color: var(--accent-strong);
    transform: translate(3px, -3px);
  }

  .channel:focus-visible {
    outline: 2px solid var(--accent-strong);
    outline-offset: 6px;
  }

  /* Contact details: shares the channels' own grid instead of a
   * separately-capped narrow box, so its width is visibly tied to the
   * composition above it rather than an accidental island — Location
   * lands under Email, Availability under GitHub, Open To under
   * LinkedIn, completing the column system the channels established
   * instead of leaving that third track empty. The section's own
   * SectionRule already draws a hairline immediately above this, so the
   * shared .spec border-top is dropped here to avoid stacking two rules
   * back to back. The shared border-bottom is dropped too — it used to
   * read as this block's own close, but it's actually a second one,
   * 16px below the .spec::after hairline added lower down for that same
   * job; padding-bottom goes with it since it only existed to clear that
   * border. */
  .contact .spec {
    max-width: none;
    margin: 0;
    padding: 0;
    border-top: none;
    border-bottom: none;
    grid-template-columns: 1fr 0.85fr 1.15fr;
    column-gap: 28px;
  }

  /* Open To's three short items reuse the shared .plain-list — a dash
   * list, not a new component — sized down slightly to sit comfortably
   * inside a dl value instead of a full section's worth of space. */
  .contact .spec .plain-list {
    gap: 6px;
    max-width: none;
  }

  .contact .spec .plain-list li {
    font-size: 0.88rem;
  }

  /* Contact Details is the page's actual close (no further section
   * follows it) — this quiet hairline marks that deliberately instead
   * of just trailing off after the last value. The one and only closing
   * rule for this block now that .spec's own border-bottom is gone. */
  .contact .spec::after {
    content: "";
    display: block;
    grid-column: 1 / -1;
    height: 1px;
    margin-top: 8px;
    background: rgba(130, 171, 207, 0.12);
  }

  @media (max-width: 1100px) {
    .channels {
      column-gap: 20px;
    }

    .channels li:not(:first-child) .channel::after {
      left: -10px;
    }

    .contact .spec {
      column-gap: 20px;
    }
  }

  /* Tablet and below: three narrow columns stop being the better shape
   * for three long endpoint strings — the matrix disassembles into a
   * plain vertical list of rows instead, same principle as Capabilities'
   * own mobile collapse: hairlines and spacing, never boxed cards. */
  @media (max-width: 820px) {
    .channels {
      grid-template-columns: 1fr;
      border-top: none;
    }

    .channel {
      padding: 18px 0;
      border-top: 1px solid rgba(130, 171, 207, 0.2);
    }

    .channels li:first-child .channel {
      border-top: 1px solid rgba(130, 171, 207, 0.2);
    }

    .channels li:not(:first-child) .channel::after {
      display: none;
    }

    .contact .spec {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .contact :global(.module-statement) {
      max-width: none;
    }

    .contact .spec {
      grid-template-columns: 1fr;
      row-gap: 16px;
    }
  }
</style>
